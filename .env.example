# ==============================================================================
# GLOROV Monorepo Deployment Environment Reference
# This file provides an aggregated inventory of all environment variables across
# @glorov/backend and @glorov/storefront for Docker Compose or CI/CD pipelines.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Provisioning
# ------------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=replace-with-a-secure-db-password-minimum-16-chars
DB_NAME=glorov_medusa_prod

# ------------------------------------------------------------------------------
# Redis Cache & Workflow Queue Provisioning
# ------------------------------------------------------------------------------
REDIS_PASSWORD=replace-with-a-secure-redis-password-minimum-16-chars

# ------------------------------------------------------------------------------
# Medusa v2 Backend Configuration
# ------------------------------------------------------------------------------
PORT=9000
NODE_ENV=production
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@postgres:5432/glorov_medusa_prod
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Cryptographic Session Secrets (Generate: openssl rand -hex 32)
JWT_SECRET=replace-with-a-very-secure-32-byte-hex-jwt-secret-string
COOKIE_SECRET=replace-with-a-very-secure-32-byte-hex-cookie-secret-string

# Allowed Web Origins (Zero Wildcards in Production)
STORE_CORS=https://glorov.in,https://www.glorov.in
ADMIN_CORS=https://admin.glorov.in
AUTH_CORS=https://glorov.in,https://admin.glorov.in

# Payment Gateways (Razorpay Production Mode)
RAZORPAY_KEY_ID=rzp_live_replace_with_production_key_id
RAZORPAY_KEY_SECRET=replace_with_production_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_production_webhook_secret
RAZORPAY_MOCK_MODE=false

# Logistics Aggregator (Shiprocket Production Mode)
SHIPROCKET_EMAIL=operations@glorov.in
SHIPROCKET_PASSWORD=replace_with_production_shiprocket_password
SHIPROCKET_WEBHOOK_TOKEN=replace_with_production_webhook_token
SHIPROCKET_PICKUP_LOCATION="Pune Central Nursery Hub"
SHIPROCKET_PICKUP_PINCODE="411001"
SHIPROCKET_MOCK_MODE=false

# Cash on Delivery Maximum Order Cap (paise)
COD_MAX_AMOUNT_PAISE=500000

# Transactional Notifications (SMTP Production)
NOTIFICATION_FROM_EMAIL=orders@glorov.in
NOTIFICATION_FROM_NAME="GLOROV Botanical Garden"
NOTIFICATION_REPLY_TO=care@glorov.in
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_ses_smtp_user
SMTP_PASSWORD=replace_with_ses_smtp_password
NOTIFICATION_MOCK_MODE=false

# ------------------------------------------------------------------------------
# Next.js Storefront Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.glorov.in
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_prod_replace_with_actual_publishable_key
NEXT_PUBLIC_BASE_URL=https://glorov.in
NEXT_PUBLIC_SITE_NAME="GLOROV — Indian Seeds & Live Plants"
