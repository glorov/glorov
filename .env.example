# ==============================================================================
# GLOROV Monorepo Deployment & Local Environment Configuration Reference
# ==============================================================================
# This file lists every environment variable utilized across the GLOROV platform.
# All values shown here are PLACEHOLDERS for development and template purposes.
# NEVER commit production secrets, private keys, or credentials to version control.
#
# USAGE:
#   - For local development:
#       cp .env.example .env                  # Root Docker services (optional)
#       cp apps/backend/.env.example apps/backend/.env
#       cp apps/storefront/.env.example apps/storefront/.env.local
#   - For production deployment:
#       Populate secrets on the secure host (/opt/glorov/.env) with 0600 permissions.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & PERSISTENCE CONFIGURATION
# ------------------------------------------------------------------------------

# Database Superuser Username
# Sensitivity: Internal Configuration
# Consumer: Docker Compose, PostgreSQL Container
# Dev Default: postgres | Prod: postgres or dedicated application user
DB_USER=postgres

# Database Superuser Password
# Sensitivity: SECRET (Must be >= 16 characters in production)
# Consumer: Docker Compose, PostgreSQL Container
DB_PASSWORD=replace-with-a-secure-db-password-minimum-16-chars

# PostgreSQL Database Name
# Sensitivity: Internal Configuration
# Consumer: Docker Compose, Medusa Backend
# Dev Default: glorov_medusa | Prod: glorov_medusa_prod
DB_NAME=glorov_medusa_prod

# Full PostgreSQL Connection URI
# Sensitivity: SECRET (Contains database password)
# Consumer: @glorov/backend (Medusa v2 Core)
# Dev: postgresql://postgres:postgrespassword@localhost:5432/glorov_medusa
# Prod: postgresql://postgres:${DB_PASSWORD}@postgres:5432/glorov_medusa_prod
DATABASE_URL=postgresql://postgres:replace-with-a-secure-db-password-minimum-16-chars@postgres:5432/glorov_medusa_prod

# Redis Cache & Background Queue Authentication Password
# Sensitivity: SECRET (Must be >= 16 characters in production)
# Consumer: Docker Compose, Redis Container
REDIS_PASSWORD=replace-with-a-secure-redis-password-minimum-16-chars

# Full Redis Connection URI
# Sensitivity: SECRET (Contains Redis password)
# Consumer: @glorov/backend (Medusa Event Bus & Workflows)
# Dev: redis://localhost:6379
# Prod: redis://:${REDIS_PASSWORD}@redis:6379
REDIS_URL=redis://:replace-with-a-secure-redis-password-minimum-16-chars@redis:6379

# Database Connection Pool Sizing
# Sensitivity: Internal Configuration
# Consumer: @glorov/backend (MikroORM Pool)
# Dev: min=2, max=5 | Prod: min=2, max=10
DB_POOL_MIN=2
DB_POOL_MAX=10


# ------------------------------------------------------------------------------
# 2. MEDUSA BACKEND RUNTIME & CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------

# HTTP Port for Medusa Backend
# Sensitivity: Internal Configuration
# Consumer: @glorov/backend
PORT=9000

# Node.js Execution Environment
# Sensitivity: Internal Configuration
# Consumer: @glorov/backend, @glorov/storefront
# Options: development | test | production
# Note: In production, backend strictly halts boot if dev secrets or mock modes are active.
NODE_ENV=production

# JSON Web Token Cryptographic Signing Secret
# Sensitivity: SECRET (Must be >= 32 characters, non-dev string generated via: openssl rand -hex 32)
# Consumer: @glorov/backend (Customer & Admin authentication tokens)
JWT_SECRET=replace-with-a-very-secure-32-byte-hex-jwt-secret-string

# Cookie Cryptographic Encryption Secret
# Sensitivity: SECRET (Must be >= 32 characters, non-dev string generated via: openssl rand -hex 32)
# Consumer: @glorov/backend (Session cookie signing)
COOKIE_SECRET=replace-with-a-very-secure-32-byte-hex-cookie-secret-string


# ------------------------------------------------------------------------------
# 3. CROSS-ORIGIN RESOURCE SHARING (CORS) RULES
# ------------------------------------------------------------------------------
# NOTE: Wildcard origins ("*") are strictly forbidden in production mode.

# Allowed Storefront Web Origins (Comma-separated)
# Sensitivity: Public Configuration
# Consumer: @glorov/backend (HTTP Server Middleware)
# Dev: http://localhost:3000 | Prod: https://glorov.in,https://www.glorov.in
STORE_CORS=https://glorov.in,https://www.glorov.in

# Allowed Admin Dashboard Origins (Comma-separated)
# Sensitivity: Public Configuration
# Consumer: @glorov/backend (HTTP Server Middleware)
# Dev: http://localhost:5173,http://localhost:9000 | Prod: https://admin.glorov.in
ADMIN_CORS=https://admin.glorov.in

# Allowed Authentication Cookie Origins (Comma-separated)
# Sensitivity: Public Configuration
# Consumer: @glorov/backend (Auth Routes Middleware)
# Dev: http://localhost:3000,http://localhost:9000 | Prod: https://glorov.in,https://admin.glorov.in
AUTH_CORS=https://glorov.in,https://admin.glorov.in


# ------------------------------------------------------------------------------
# 4. INDIAN PAYMENT GATEWAY — RAZORPAY
# ------------------------------------------------------------------------------

# Razorpay Merchant Key ID
# Sensitivity: Server-Side Configuration (Public Key)
# Consumer: @glorov/backend (src/modules/payment-razorpay)
# Dev/Test: rzp_test_xxxxxxxxxxxxxxxx | Prod: rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_live_replace_with_production_key_id

# Razorpay Merchant Key Secret
# Sensitivity: SECRET (Never expose to client or version control)
# Consumer: @glorov/backend (src/modules/payment-razorpay)
RAZORPAY_KEY_SECRET=replace_with_production_key_secret

# Razorpay Webhook Cryptographic Verification Secret
# Sensitivity: SECRET (Used to verify HMAC-SHA256 signature on incoming webhooks)
# Consumer: @glorov/backend (src/modules/payment-razorpay)
RAZORPAY_WEBHOOK_SECRET=replace_with_production_webhook_secret

# Razorpay Mock Mode Bypass
# Sensitivity: Internal Flag
# Consumer: @glorov/backend
# Dev: true (allows offline checkout testing) | Prod: MUST BE false (fatal error if true)
RAZORPAY_MOCK_MODE=false


# ------------------------------------------------------------------------------
# 5. CASH ON DELIVERY (COD) BUSINESS RULES
# ------------------------------------------------------------------------------

# Maximum Order Total Eligible for Cash on Delivery (in paise)
# Sensitivity: Business Configuration
# Consumer: @glorov/backend (src/modules/payment-cod)
# 500000 paise = ₹5,000 INR
COD_MAX_AMOUNT_PAISE=500000


# ------------------------------------------------------------------------------
# 6. INDIAN LOGISTICS AGGREGATOR — SHIPROCKET
# ------------------------------------------------------------------------------

# Registered Shiprocket Enterprise Account Email
# Sensitivity: Server-Side Configuration
# Consumer: @glorov/backend (src/modules/fulfillment-shiprocket)
SHIPROCKET_EMAIL=operations@glorov.in

# Shiprocket Account Password
# Sensitivity: SECRET (Used to request bearer authorization tokens)
# Consumer: @glorov/backend (src/modules/fulfillment-shiprocket)
SHIPROCKET_PASSWORD=replace_with_production_shiprocket_password

# Webhook Authorization Token
# Sensitivity: SECRET (Verified on incoming /fulfillment/shiprocket/webhook calls)
# Consumer: @glorov/backend (src/modules/fulfillment-shiprocket)
SHIPROCKET_WEBHOOK_TOKEN=replace_with_production_webhook_token

# Registered Warehouse Pickup Location Nickname
# Sensitivity: Configuration (Must match Shiprocket Dashboard address nickname exactly)
# Consumer: @glorov/backend (src/modules/fulfillment-shiprocket)
SHIPROCKET_PICKUP_LOCATION="Pune Central Nursery Hub"

# Primary Dispatch Warehouse PIN Code
# Sensitivity: Configuration
# Consumer: @glorov/backend (src/modules/fulfillment-shiprocket)
SHIPROCKET_PICKUP_PINCODE="411001"

# Shiprocket Mock Mode Bypass
# Sensitivity: Internal Flag
# Consumer: @glorov/backend
# Dev: true (allows offline courier tests) | Prod: MUST BE false (fatal error if true)
SHIPROCKET_MOCK_MODE=false


# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL NOTIFICATIONS (SMTP)
# ------------------------------------------------------------------------------

# Outgoing "From" Email Address
# Sensitivity: Public Configuration
# Consumer: @glorov/backend (src/modules/notification-email)
NOTIFICATION_FROM_EMAIL=orders@glorov.in

# Outgoing "From" Display Name
# Sensitivity: Public Configuration
# Consumer: @glorov/backend (src/modules/notification-email)
NOTIFICATION_FROM_NAME="GLOROV Botanical Garden"

# Customer Support "Reply-To" Email Address
# Sensitivity: Public Configuration
# Consumer: @glorov/backend (src/modules/notification-email)
NOTIFICATION_REPLY_TO=care@glorov.in

# SMTP Relay Hostname
# Sensitivity: Configuration
# Consumer: @glorov/backend (src/modules/notification-email)
# Dev: smtp.mailtrap.io | Prod: email-smtp.ap-south-1.amazonaws.com (AWS SES Mumbai)
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com

# SMTP Port Number
# Sensitivity: Configuration
# Consumer: @glorov/backend
# Dev: 587 or 2525 | Prod: 587 (TLS/STARTTLS)
SMTP_PORT=587

# Enforce Direct TLS Connection
# Sensitivity: Configuration
# Options: false (STARTTLS on port 587) | true (Direct SSL on port 465)
SMTP_SECURE=false

# SMTP Relay Username
# Sensitivity: SECRET
# Consumer: @glorov/backend (Nodemailer Transport)
SMTP_USER=replace_with_ses_smtp_user

# SMTP Relay Password
# Sensitivity: SECRET
# Consumer: @glorov/backend (Nodemailer Transport)
SMTP_PASSWORD=replace_with_ses_smtp_password

# Notification Mock Mode Bypass
# Sensitivity: Internal Flag
# Dev: true (logs emails to console without sending) | Prod: MUST BE false
NOTIFICATION_MOCK_MODE=false


# ------------------------------------------------------------------------------
# 8. SRE OBSERVABILITY & LOGGING CONFIGURATION
# ------------------------------------------------------------------------------

# Minimum Log Severity Level
# Sensitivity: Configuration
# Consumer: @glorov/backend (Pino Logger)
# Options: debug | info | warn | error
LOG_LEVEL=info

# Latency Alert Threshold (P95 milliseconds)
# Sensitivity: Configuration
ALERT_LATENCY_P95_MS=1500

# Error Rate Percentage Alert Threshold
# Sensitivity: Configuration
ALERT_ERROR_RATE_PERCENT=5.0

# Hourly Payment Failure Warning Threshold
# Sensitivity: Configuration
ALERT_PAYMENT_FAILURE_THRESHOLD_HOURLY=3


# ------------------------------------------------------------------------------
# 9. STOREFRONT CLIENT & PUBLIC ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# IMPORTANT: All variables prefixed with "NEXT_PUBLIC_" are bundled into client
# JavaScript and are visible to anyone inspecting web traffic.
# NEVER put private credentials, database strings, or secret keys here.

# Target Medusa Backend URL
# Sensitivity: Public URL (In production, MUST use HTTPS)
# Consumer: @glorov/storefront (Browser fetch & server-side rendering)
# Dev: http://localhost:9000 | Prod: https://api.glorov.in
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.glorov.in

# Medusa Storefront Publishable API Key
# Sensitivity: Public Key (Scoped strictly to the Web Storefront sales channel)
# Consumer: @glorov/storefront
# Dev: pk_test_... | Prod: pk_live_... (Generated in Medusa Admin -> Settings -> Publishable API Keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_live_replace_with_production_key

# Canonical Storefront Base URL
# Sensitivity: Public URL (Used for SEO canonicals, sitemap.xml, robots.txt, OpenGraph)
# Consumer: @glorov/storefront
# Dev: http://localhost:3000 | Prod: https://glorov.in
NEXT_PUBLIC_BASE_URL=https://glorov.in

# Brand Display Name
# Sensitivity: Public Configuration
# Consumer: @glorov/storefront
NEXT_PUBLIC_SITE_NAME="GLOROV — Indian Seeds & Live Plants"

