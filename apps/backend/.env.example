# ==============================================================================
# GLOROV Backend Environment Configuration Example
# Copy this file to .env and configure for your local or staging environment.
# NEVER commit production secrets or real API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Environment
# ------------------------------------------------------------------------------
PORT=9000
NODE_ENV=development # development | test | production

# ------------------------------------------------------------------------------
# 2. Database & Cache Connectivity
# ------------------------------------------------------------------------------
# Local Docker Postgres: postgresql://postgres:postgrespassword@localhost:5432/glorov_medusa
# Supabase Session Pooler (port 5432): postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/glorov_medusa
REDIS_URL=redis://localhost:6379

# Database Connection Pool Tuning
DB_POOL_MIN=2
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# 3. Security Secrets & Tokens
# Generate secure 32+ character random strings in production: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET=replace-with-a-very-secure-32-byte-hex-jwt-secret-string
COOKIE_SECRET=replace-with-a-very-secure-32-byte-hex-cookie-secret-string

# ------------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS)
# NEVER use wildcard "*" in production
# ------------------------------------------------------------------------------
STORE_CORS=http://localhost:3000,http://localhost:8000,https://glorov.com,https://www.glorov.com,https://glorov.tech,https://www.glorov.tech
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://admin.glorov.com,https://admin.glorov.tech
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:9000,https://glorov.com,https://admin.glorov.com,https://glorov.tech,https://admin.glorov.tech

# ------------------------------------------------------------------------------
# 5. Razorpay Indian Payment Gateway (Server-side Only)
# Test: rzp_test_... | Live: rzp_live_...
# NEVER expose RAZORPAY_KEY_SECRET to client browsers
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
# Set to "true" ONLY for offline local development without calling Razorpay
RAZORPAY_MOCK_MODE=false

# ------------------------------------------------------------------------------
# 6. Shiprocket Logistics Aggregator (Server-side Only)
# ------------------------------------------------------------------------------
SHIPROCKET_EMAIL=operations@glorov.in
SHIPROCKET_PASSWORD=replace_with_shiprocket_password
SHIPROCKET_WEBHOOK_TOKEN=replace_with_secure_shiprocket_webhook_token
SHIPROCKET_PICKUP_LOCATION="Pune Central Nursery Hub"
SHIPROCKET_PICKUP_PINCODE="411001"
# Set to "true" ONLY for offline local development without calling Shiprocket APIs
SHIPROCKET_MOCK_MODE=false

# ------------------------------------------------------------------------------
# 7. Cash on Delivery (COD) Business Rules
# Maximum allowed COD cart total in paise (500000 = ₹5,000)
# ------------------------------------------------------------------------------
COD_MAX_AMOUNT_PAISE=500000

# ------------------------------------------------------------------------------
# 8. Transactional Email & Notifications (SMTP)
# Development: Mailtrap / Ethereal | Production: AWS SES / SendGrid / Postmark
# ------------------------------------------------------------------------------
NOTIFICATION_FROM_EMAIL=orders@glorov.in
NOTIFICATION_FROM_NAME="GLOROV Botanical Garden"
NOTIFICATION_REPLY_TO=care@glorov.in
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_user
SMTP_PASSWORD=replace_with_smtp_password
# Set to "true" to log notifications to stdout without dispatching SMTP emails
NOTIFICATION_MOCK_MODE=false

# ------------------------------------------------------------------------------
# 9. SRE Observability & Alerting Thresholds
# ------------------------------------------------------------------------------
ALERT_LATENCY_P95_MS=1500
ALERT_ERROR_RATE_PERCENT=5.0
ALERT_PAYMENT_FAILURE_THRESHOLD_HOURLY=3
LOG_LEVEL=info # debug | info | warn | error

# ------------------------------------------------------------------------------
# 10. External Error Reporting (Sentry)
# ------------------------------------------------------------------------------
# Sentry DSN for capturing 5xx errors and async dead-letter failures.
# Leave empty for local development to use structured stdout logging.
SENTRY_DSN=your_sentry_dsn_here
