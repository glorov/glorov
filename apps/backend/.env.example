# GLOROV Backend Environment Configuration Example
# Copy this file to .env and configure your environment

# Server & Runtime
PORT=9000
NODE_ENV=development

# Database & Cache
# Local Docker Postgres: postgresql://postgres:postgrespassword@localhost:5432/glorov_medusa
# Supabase Session Pooler (port 5432): postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/glorov_medusa
REDIS_URL=redis://localhost:6379

# Database Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# Security Secrets (Generate secure random 32-byte hex strings in production)
JWT_SECRET=supersecret-dev-jwt-token-change-in-prod
COOKIE_SECRET=supersecret-dev-cookie-token-change-in-prod

# CORS Configurations (Do NOT use wildcard * in production)
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:9000

# Feature Flags
MEDUSA_ADMIN_ONBOARDING_TYPE=default
