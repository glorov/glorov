{
  "name": "@glorov/backend",
  "version": "0.1.0",
  "description": "GLOROV Commerce Backend - Medusa v2 Modular Engine",
  "author": "GLOROV Engineering",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "medusa db:migrate --skip-search --execute-safe-links",
    "db:create": "medusa db:create",
    "user": "medusa user",
    "test": "pnpm test:unit",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@glorov/types": "workspace:*",
    "@medusajs/admin-sdk": "2.22.0",
    "@medusajs/admin-shared": "2.22.0",
    "@medusajs/caching": "2.22.0",
    "@medusajs/cli": "2.22.0",
    "@medusajs/dashboard": "2.22.0",
    "@medusajs/draft-order": "2.22.0",
    "@medusajs/framework": "2.22.0",
    "@medusajs/medusa": "2.22.0",
    "@medusajs/ui": "4.2.6",
    "@tanstack/react-query": "5.64.2",
    "nodemailer": "^10.2.1",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@glorov/config": "workspace:*",
    "@medusajs/eslint-plugin": "2.22.0",
    "@medusajs/test-utils": "2.22.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}