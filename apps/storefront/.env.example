# GLOROV Storefront Environment Configuration Example
# Copy this file to .env.local for local development

# Public API Endpoints
# Points to Medusa v2 backend
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa Publishable API Key (Created in Medusa Admin -> Settings -> Publishable API Keys)
# Scoped specifically to the Web Storefront Sales Channel
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_test_replace_with_actual_key

# Public App URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Site Metadata
NEXT_PUBLIC_SITE_NAME="GLOROV — Indian Seeds & Live Plants"
