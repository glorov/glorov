# ==============================================================================
# GLOROV Storefront Environment Configuration Example
# Copy this file to .env.local for local development.
# IMPORTANT: All variables in this file are exposed to the client browser bundle.
# NEVER add private secrets, database URLs, or payment secret keys here.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Medusa v2 Backend Connectivity
# Local: http://localhost:9000 | Staging: https://api-staging.glorov.in | Production: https://api.glorov.in
# In production, this MUST use HTTPS.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# ------------------------------------------------------------------------------
# 2. Medusa Publishable API Key
# Generated in Medusa Admin -> Settings -> Publishable API Keys
# Scoped specifically to the Web Storefront Sales Channel
# Format: pk_...
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_test_replace_with_actual_key

# ------------------------------------------------------------------------------
# 3. Canonical Base URL
# Used for SEO canonical tags, Open Graph meta tags, sitemap.xml, and robots.txt
# Local: http://localhost:3000 | Production: https://glorov.in
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Brand & Site Metadata
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="GLOROV — Indian Seeds & Live Plants"
