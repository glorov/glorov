# ==============================================================================
# GLOROV Storefront Environment Configuration Reference
# ==============================================================================
# Copy this file to .env.local for local Next.js development:
#   cp .env.example .env.local
#
# IMPORTANT:
# - NEXT_PUBLIC_ variables are bundled and visible to browser clients.
# - NEVER put admin secrets, database credentials, or private payment secrets here.
# ==============================================================================

# URL of the Medusa Commerce Backend
# Dev: http://localhost:9000 | Prod: https://api.glorov.in
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key from Medusa Admin -> Settings -> Publishable API Keys
# Publicly safe token used to link storefront requests to the India sales channel
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_test_placeholder_key_for_storefront

# Canonical URL of this storefront web application
# Dev: http://localhost:3000 | Prod: https://glorov.in
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Brand Site Name
NEXT_PUBLIC_SITE_NAME="GLOROV — Indian Seeds & Live Plants"

# Default Region Code (India)
NEXT_PUBLIC_DEFAULT_REGION=in

# Default Currency Code (INR)
NEXT_PUBLIC_DEFAULT_CURRENCY=inr

# Razorpay Payment Gateway Public Key ID
# Dev: rzp_test_placeholder | Prod: rzp_live_...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_glorov_storefront_key
