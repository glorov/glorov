{
  "name": "glorov",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0 <=24.x"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "backend:dev": "turbo dev --filter=@glorov/backend",
    "backend:build": "turbo build --filter=@glorov/backend",
    "backend:migrate": "pnpm --filter @glorov/backend db:migrate",
    "backend:seed": "pnpm --filter @glorov/backend exec ./src/scripts/seed-india-region.ts",
    "storefront:dev": "pnpm --filter @glorov/storefront dev",
    "storefront:build": "pnpm --filter @glorov/storefront build",
    "storefront:test": "pnpm --filter @glorov/storefront test",
    "storefront:test:e2e": "pnpm --filter @glorov/storefront test:e2e",
    "storefront:typecheck": "pnpm --filter @glorov/storefront typecheck",
    "storefront:lint": "pnpm --filter @glorov/storefront lint",
    "flutter:test": "cd flutter && flutter test",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:backup": "./scripts/db-backup.sh",
    "db:restore": "./scripts/db-restore.sh",
    "db:backup:verify": "./scripts/db-backup-verify.sh",
    "smoke:test": "node scripts/smoke-test.mjs",
    "deploy:vercel": "curl -s -X POST https://api.vercel.com/v1/integrations/deploy/prj_hW7jKJQqYAvhMuMKp7YvbAxCVj23/K5XdXMujZi",
    "deploy:github": "git push origin main && pnpm deploy:vercel",
    "deploy:vm": "./scripts/deploy-vm.sh",
    "deploy:firebase": "./scripts/deploy-firebase.sh",
    "deploy:domain": "./deploy/reload-services.sh",
    "deploy:all": "./scripts/deploy-all.sh"
  },
  "pnpm": {
    "overrides": {
      "tsconfig-paths": "^4.2.0"
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14",
    "typescript": "^5.6.2"
  }
}
