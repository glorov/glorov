{
  "name": "glorov",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "backend:dev": "turbo dev --filter=@glorov/backend",
    "backend:build": "turbo build --filter=@glorov/backend",
    "backend:migrate": "pnpm --filter @glorov/backend db:migrate",
    "storefront:dev": "turbo dev --filter=@glorov/storefront",
    "storefront:build": "turbo build --filter=@glorov/storefront",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down"
  },
  "pnpm": {
    "overrides": {
      "tsconfig-paths": "^4.2.0"
    }
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.0.14",
    "typescript": "^5.6.2"
  }
}
